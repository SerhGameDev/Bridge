<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>9.0</LangVersion><Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><Version>0.1.0</Version><Authors>SershDev</Authors>
    <Description>Explicit command hosting and policy-bound Bridge data, independent of Unity and transport.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression><RepositoryUrl>https://github.com/SerhGameDev/Bridge</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile><GenerateDocumentationFile>true</GenerateDocumentationFile><NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.serhgamedev.bridge.runtime/Runtime/**/*.cs" LinkBase="Runtime" />
    <ProjectReference Include="../Bridge.Core/Bridge.Core.csproj" />
    <None Include="../../Packages/com.serhgamedev.bridge.runtime/README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
